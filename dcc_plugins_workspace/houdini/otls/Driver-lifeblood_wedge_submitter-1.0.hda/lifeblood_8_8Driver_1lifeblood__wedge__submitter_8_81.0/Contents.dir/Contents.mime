      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"attrib_type\") }
    }
    channel val_int_2 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"attrib_range_intx\") }
    }
    channel val_int_3 {
      lefttype = extend
      righttype = extend
      default = 9
      flags = 0
      segment { length = 0 value = 9 9 expr = ch(\"attrib_range_inty\") }
    }
    channel val_int_4 {
      lefttype = extend
      righttype = extend
      default = 10
      flags = 0
      segment { length = 0 value = 10 10 expr = ch(\"attrib_range_intz\") }
    }
    channel val_flt_2 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"attrib_range_floatx\") }
    }
    channel val_flt_3 {
      lefttype = extend
      righttype = extend
      flags = 0
